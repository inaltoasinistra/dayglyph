#!/usr/bin/env python3
"""Dayglyph: encode dates as two Unicode characters and decode to the nearest date to today in UTC."""

import argparse
import hashlib
from calendar import monthrange
from datetime import date, datetime, timedelta, timezone


# Keep visual groups reviewable; the encoding order is derived independently below.
